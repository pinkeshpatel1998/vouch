@import "tailwindcss";

/* ============================================================
   VOUCH DESIGN TOKENS
   Two layers:
   1. Raw palette + primitives (--v-*), swapped for dark mode
   2. @theme inline semantic aliases -> Tailwind utilities
   Accent is a single runtime variable. Override --v-accent on any
   subtree (a space, the wall widget) and every tint follows.
   ============================================================ */

@custom-variant dark (&:where([data-theme="dark"], [data-theme="dark"] *));

:root {
  /* --- warm neutral ramp (oklch, hue ~65-90) --- */
  --v-ink-950: oklch(0.176 0.012 65);
  --v-ink-900: oklch(0.238 0.012 65);
  --v-ink-800: oklch(0.318 0.011 65);
  --v-ink-700: oklch(0.418 0.010 65);
  --v-ink-600: oklch(0.520 0.009 68);
  --v-ink-500: oklch(0.620 0.008 70);
  --v-ink-400: oklch(0.722 0.007 72);
  --v-ink-300: oklch(0.822 0.006 78);
  --v-ink-200: oklch(0.892 0.005 82);
  --v-ink-100: oklch(0.940 0.004 85);
  --v-ink-50:  oklch(0.972 0.004 88);
  --v-paper:   oklch(0.986 0.005 92);

  /* --- accent: clay. One knob. Everything below is derived. --- */
  --v-accent: oklch(0.582 0.148 38);

  /* --- status --- */
  --v-success: oklch(0.585 0.128 158);
  --v-warning: oklch(0.712 0.148 76);
  --v-danger:  oklch(0.578 0.196 25);

  /* --- semantic surfaces (light). Repeated on [data-theme="light"] below so a
         nested container can opt back into light inside a dark page. --- */
  --v-bg:            var(--v-paper);
  --v-surface:       oklch(1 0 0);
  --v-surface-sunk:  var(--v-ink-50);
  --v-surface-hover: var(--v-ink-50);
  --v-border:        oklch(0.892 0.005 82 / 0.9);
  --v-border-strong: var(--v-ink-300);
  --v-text:          var(--v-ink-950);
  --v-text-muted:    var(--v-ink-600);
  --v-text-subtle:   var(--v-ink-500);
  --v-text-onaccent: oklch(0.99 0.005 60);

  /* --- accent derivations: never hand-pick a second brand colour --- */
  --v-accent-hover: color-mix(in oklab, var(--v-accent) 88%, black);
  --v-accent-press: color-mix(in oklab, var(--v-accent) 76%, black);
  --v-accent-soft:  color-mix(in oklab, var(--v-accent) 12%, var(--v-surface));
  --v-accent-line:  color-mix(in oklab, var(--v-accent) 28%, var(--v-border));
  --v-accent-text:  color-mix(in oklab, var(--v-accent) 82%, var(--v-ink-950));
  --v-ring:         color-mix(in oklab, var(--v-accent) 55%, transparent);

  /* --- radius scale --- */
  --v-radius-xs: 0.25rem;
  --v-radius-sm: 0.375rem;
  --v-radius-md: 0.625rem;
  --v-radius-lg: 0.875rem;
  --v-radius-xl: 1.25rem;
  --v-radius-2xl: 1.75rem;

  /* --- exactly three shadow levels, warm-tinted --- */
  --v-shadow-low:
    0 1px 1px oklch(0.24 0.012 65 / 0.04),
    0 1px 2px oklch(0.24 0.012 65 / 0.06);
  --v-shadow-mid:
    0 1px 2px oklch(0.24 0.012 65 / 0.04),
    0 6px 14px -3px oklch(0.24 0.012 65 / 0.08);
  --v-shadow-high:
    0 2px 4px oklch(0.24 0.012 65 / 0.04),
    0 12px 24px -6px oklch(0.24 0.012 65 / 0.10),
    0 32px 56px -20px oklch(0.24 0.012 65 / 0.14);

  /* --- motion. One considered moment, so keep the vocabulary tiny. --- */
  --v-ease-out: cubic-bezier(0.22, 1, 0.36, 1);
  --v-ease-in-out: cubic-bezier(0.65, 0, 0.35, 1);
  --v-dur-fast: 120ms;
  --v-dur-base: 220ms;
  --v-dur-slow: 420ms;
}

/* system dark, unless the user explicitly chose light */
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --v-bg:            oklch(0.164 0.010 68);
    --v-surface:       oklch(0.208 0.011 68);
    --v-surface-sunk:  oklch(0.144 0.010 68);
    --v-surface-hover: oklch(0.248 0.012 68);
    --v-border:        oklch(0.318 0.011 68 / 0.9);
    --v-border-strong: oklch(0.418 0.010 68);
    --v-text:          oklch(0.968 0.005 88);
    --v-text-muted:    oklch(0.742 0.008 74);
    --v-text-subtle:   oklch(0.622 0.008 70);
    /* Only a lift of the default; an inline --v-accent from a space wins. */
    --v-accent:        oklch(0.672 0.142 40);
    --v-accent-hover:  color-mix(in oklab, var(--v-accent) 88%, white);
    --v-accent-press:  color-mix(in oklab, var(--v-accent) 76%, white);
    --v-accent-soft:   color-mix(in oklab, var(--v-accent) 16%, var(--v-surface));
    --v-accent-text:   color-mix(in oklab, var(--v-accent) 78%, oklch(0.98 0 0));
    --v-text-onaccent: oklch(0.16 0.012 60);
    --v-shadow-low:  0 1px 2px oklch(0 0 0 / 0.34);
    --v-shadow-mid:  0 1px 2px oklch(0 0 0 / 0.30), 0 6px 14px -3px oklch(0 0 0 / 0.40);
    --v-shadow-high: 0 2px 4px oklch(0 0 0 / 0.30), 0 12px 24px -6px oklch(0 0 0 / 0.44), 0 32px 56px -20px oklch(0 0 0 / 0.56);
  }
}

/* Explicit choice wins in both directions, and is scoped to the element
   rather than the document -- the wall builder renders a light preview
   inside a dark page and vice versa. */
[data-theme="light"] {
  --v-bg:            var(--v-paper);
  --v-surface:       oklch(1 0 0);
  --v-surface-sunk:  var(--v-ink-50);
  --v-surface-hover: var(--v-ink-50);
  --v-border:        oklch(0.892 0.005 82 / 0.9);
  --v-border-strong: var(--v-ink-300);
  --v-text:          var(--v-ink-950);
  --v-text-muted:    var(--v-ink-600);
  --v-text-subtle:   var(--v-ink-500);
  --v-text-onaccent: oklch(0.99 0.005 60);
  --v-accent-hover: color-mix(in oklab, var(--v-accent) 88%, black);
  --v-accent-press: color-mix(in oklab, var(--v-accent) 76%, black);
  --v-accent-soft:  color-mix(in oklab, var(--v-accent) 12%, var(--v-surface));
  --v-accent-text:  color-mix(in oklab, var(--v-accent) 82%, var(--v-ink-950));
  --v-shadow-low:
    0 1px 1px oklch(0.24 0.012 65 / 0.04),
    0 1px 2px oklch(0.24 0.012 65 / 0.06);
  --v-shadow-mid:
    0 1px 2px oklch(0.24 0.012 65 / 0.04),
    0 6px 14px -3px oklch(0.24 0.012 65 / 0.08);
  --v-shadow-high:
    0 2px 4px oklch(0.24 0.012 65 / 0.04),
    0 12px 24px -6px oklch(0.24 0.012 65 / 0.10),
    0 32px 56px -20px oklch(0.24 0.012 65 / 0.14);
}

[data-theme="dark"] {
  --v-bg:            oklch(0.164 0.010 68);
  --v-surface:       oklch(0.208 0.011 68);
  --v-surface-sunk:  oklch(0.144 0.010 68);
  --v-surface-hover: oklch(0.248 0.012 68);
  --v-border:        oklch(0.318 0.011 68 / 0.9);
  --v-border-strong: oklch(0.418 0.010 68);
  --v-text:          oklch(0.968 0.005 88);
  --v-text-muted:    oklch(0.742 0.008 74);
  --v-text-subtle:   oklch(0.622 0.008 70);
  --v-accent:        oklch(0.672 0.142 40);
  --v-accent-hover:  color-mix(in oklab, var(--v-accent) 88%, white);
  --v-accent-press:  color-mix(in oklab, var(--v-accent) 76%, white);
  --v-accent-soft:   color-mix(in oklab, var(--v-accent) 16%, var(--v-surface));
  --v-accent-text:   color-mix(in oklab, var(--v-accent) 78%, oklch(0.98 0 0));
  --v-text-onaccent: oklch(0.16 0.012 60);
  --v-shadow-low:  0 1px 2px oklch(0 0 0 / 0.34);
  --v-shadow-mid:  0 1px 2px oklch(0 0 0 / 0.30), 0 6px 14px -3px oklch(0 0 0 / 0.40);
  --v-shadow-high: 0 2px 4px oklch(0 0 0 / 0.30), 0 12px 24px -6px oklch(0 0 0 / 0.44), 0 32px 56px -20px oklch(0 0 0 / 0.56);
}

/* ============================================================
   Semantic layer -> Tailwind utilities.
   `inline` keeps the var() at the use site, so dark-mode and
   per-space accent overrides cascade normally.
   ============================================================ */
@theme inline {
  --color-bg: var(--v-bg);
  --color-surface: var(--v-surface);
  --color-sunk: var(--v-surface-sunk);
  --color-hover: var(--v-surface-hover);
  --color-line: var(--v-border);
  --color-line-strong: var(--v-border-strong);

  --color-ink: var(--v-text);
  --color-muted: var(--v-text-muted);
  --color-subtle: var(--v-text-subtle);

  --color-accent: var(--v-accent);
  --color-accent-hover: var(--v-accent-hover);
  --color-accent-press: var(--v-accent-press);
  --color-accent-soft: var(--v-accent-soft);
  --color-accent-line: var(--v-accent-line);
  --color-accent-text: var(--v-accent-text);
  --color-onaccent: var(--v-text-onaccent);

  --color-success: var(--v-success);
  --color-warning: var(--v-warning);
  --color-danger: var(--v-danger);

  --radius-xs: var(--v-radius-xs);
  --radius-sm: var(--v-radius-sm);
  --radius-md: var(--v-radius-md);
  --radius-lg: var(--v-radius-lg);
  --radius-xl: var(--v-radius-xl);
  --radius-2xl: var(--v-radius-2xl);

  --shadow-low: var(--v-shadow-low);
  --shadow-mid: var(--v-shadow-mid);
  --shadow-high: var(--v-shadow-high);

  --font-display: var(--font-fraunces), ui-serif, Georgia, serif;
  --font-sans: var(--font-instrument-sans), ui-sans-serif, system-ui, sans-serif;
  --font-mono: var(--font-jetbrains-mono), ui-monospace, SFMono-Regular, monospace;

  --ease-out-quint: var(--v-ease-out);
  --ease-smooth: var(--v-ease-in-out);
}

/* ============================================================
   Base
   ============================================================ */
@layer base {
  * {
    border-color: var(--v-border);
  }

  html {
    -webkit-text-size-adjust: 100%;
    text-rendering: optimizeLegibility;
  }

  body {
    background-color: var(--v-bg);
    color: var(--v-text);
    font-family: var(--font-sans);
    font-feature-settings: "cv05" 1, "ss01" 1;
    -webkit-font-smoothing: antialiased;
  }

  /* Display face: optical size + slight wonk is the whole point of Fraunces */
  .font-display {
    font-variation-settings: "SOFT" 0, "WONK" 1, "opsz" 40;
    letter-spacing: -0.02em;
  }

  /* Visible focus everywhere. Never remove, only restyle. */
  :focus-visible {
    outline: 2px solid var(--v-accent);
    outline-offset: 2px;
    border-radius: var(--v-radius-xs);
  }

  ::selection {
    background: color-mix(in oklab, var(--v-accent) 26%, transparent);
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }
}

@layer utilities {
  /* The one motion moment: cards settling into the wall. */
  @keyframes v-settle {
    from {
      opacity: 0;
      transform: translateY(14px) scale(0.985);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .animate-settle {
    animation: v-settle var(--v-dur-slow) var(--v-ease-out) both;
  }

  /* Carousel template: marquee. Continuous, pauses on hover and on focus
     within, and stops entirely under reduced motion (handled globally). */
  @keyframes v-marquee {
    to {
      transform: translateX(-50%);
    }
  }
  .animate-marquee {
    animation: v-marquee var(--marquee-duration, 60s) linear infinite;
    will-change: transform;
  }
  .marquee-host:hover .animate-marquee,
  .marquee-host:focus-within .animate-marquee {
    animation-play-state: paused;
  }
  /* Edges fade so cards enter and leave rather than being cut off. */
  .marquee-mask {
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
  }

  @keyframes v-shimmer {
    100% { transform: translateX(100%); }
  }
  .skeleton {
    position: relative;
    overflow: hidden;
    background: var(--v-surface-sunk);
  }
  .skeleton::after {
    content: "";
    position: absolute;
    inset: 0;
    transform: translateX(-100%);
    background: linear-gradient(
      90deg,
      transparent,
      color-mix(in oklab, var(--v-text) 6%, transparent),
      transparent
    );
    animation: v-shimmer 1.6s infinite;
  }
}
